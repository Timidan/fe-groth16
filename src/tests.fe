// Verifier tests against proofs generated by snarkjs 0.7.6 (see scripts/).
// Run with `fe test`.

use ingot::{G1, G2, Proof, Q, R, Rejection, verify}
use ingot::multiplier_key::{MULTIPLIER_VK, MultiplierVerifier, MultiplierVerifierMsg}
use ingot::preimage_key::{PREIMAGE_VK, PreimageVerifier, PreimageVerifierMsg}
use ingot::vectors::{
    ALICE,
    ALICE_INPUTS,
    BOB,
    BOB_2,
    BOB_2_INPUTS,
    BOB_INPUTS,
    MUL_1,
    MUL_1_INPUTS,
    MUL_2,
    MUL_2_INPUTS,
    MUL_ZERO,
    MUL_ZERO_INPUTS,
}

const OK: u8 = 0
const INPUT_NOT_IN_FIELD: u8 = 1
const COORDINATE_NOT_IN_FIELD: u8 = 2
const NOT_ON_CURVE: u8 = 3
const COMMITMENT_CALL_FAILED: u8 = 4
const PAIRING_CALL_FAILED: u8 = 5
const PAIRING_MISMATCH: u8 = 6

fn outcome(_ result: Result<Rejection, ()>) -> u8 {
    match result {
        Result::Ok(()) => OK,
        Result::Err(Rejection::InputNotInField) => INPUT_NOT_IN_FIELD,
        Result::Err(Rejection::CoordinateNotInField) => COORDINATE_NOT_IN_FIELD,
        Result::Err(Rejection::NotOnCurve) => NOT_ON_CURVE,
        Result::Err(Rejection::CommitmentCallFailed) => COMMITMENT_CALL_FAILED,
        Result::Err(Rejection::PairingCallFailed) => PAIRING_CALL_FAILED,
        Result::Err(Rejection::PairingMismatch) => PAIRING_MISMATCH,
    }
}

#[test]
fn snarkjs_proofs_verify() {
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: MUL_1, inputs: MUL_1_INPUTS),
            ) == OK,
    )
    assert!(
        outcome(verify(vk: PREIMAGE_VK, proof: BOB, inputs: BOB_INPUTS)) == OK,
    )
    assert!(
        outcome(
                verify(vk: PREIMAGE_VK, proof: ALICE, inputs: ALICE_INPUTS),
            ) == OK,
    )
}

// Groth16 proofs are randomised: two proofs of one statement differ, and both
// verify. A contract must not use the proof bytes as a replay nullifier.
#[test]
fn second_proof_of_same_statement_verifies() {
    assert!(MUL_1.a.x != MUL_2.a.x)
    assert!(MUL_1_INPUTS[0] == MUL_2_INPUTS[0])
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: MUL_2, inputs: MUL_2_INPUTS),
            ) == OK,
    )
    assert!(BOB.a.x != BOB_2.a.x)
    assert!(
        outcome(
                verify(vk: PREIMAGE_VK, proof: BOB_2, inputs: BOB_2_INPUTS),
            ) == OK,
    )
}

#[test]
fn wrong_public_input_is_rejected() {
    assert!(MUL_1_INPUTS[0] == 33)
    assert!(
        outcome(verify(vk: MULTIPLIER_VK, proof: MUL_1, inputs: [34])) == PAIRING_MISMATCH,
    )
}

// The proof is bound to the recipient: Bob's proof does not verify for Alice.
#[test]
fn proof_does_not_transfer_to_another_recipient() {
    assert!(BOB_INPUTS[0] == ALICE_INPUTS[0])
    assert!(BOB_INPUTS[1] == 0xb0b)
    assert!(
        outcome(verify(vk: PREIMAGE_VK, proof: BOB, inputs: ALICE_INPUTS)) == PAIRING_MISMATCH,
    )
}

// `33 + R` and `33` are the same field element. The precompile would reduce
// it and accept, so `verify` rejects it before.
#[test]
fn input_outside_scalar_field_is_rejected() {
    assert!(
        outcome(verify(vk: MULTIPLIER_VK, proof: MUL_1, inputs: [33 + R])) == INPUT_NOT_IN_FIELD,
    )
    assert!(
        outcome(
                verify(
                    vk: PREIMAGE_VK,
                    proof: BOB,
                    inputs: [BOB_INPUTS[0], 0xb0b + R],
                ),
            )
            == INPUT_NOT_IN_FIELD,
    )
    assert!(
        outcome(verify(vk: MULTIPLIER_VK, proof: MUL_1, inputs: [R - 1])) == PAIRING_MISMATCH,
    )
}

// Zero is a valid public input, and R, its other encoding, is not.
#[test]
fn zero_input_verifies_and_r_is_refused() {
    assert!(MUL_ZERO_INPUTS[0] == 0)
    assert!(
        outcome(
                verify(
                    vk: MULTIPLIER_VK,
                    proof: MUL_ZERO,
                    inputs: MUL_ZERO_INPUTS,
                ),
            ) == OK,
    )
    assert!(
        outcome(verify(vk: MULTIPLIER_VK, proof: MUL_ZERO, inputs: [R])) == INPUT_NOT_IN_FIELD,
    )
}

#[test]
fn proof_from_another_circuit_is_rejected() {
    assert!(
        outcome(verify(vk: PREIMAGE_VK, proof: MUL_1, inputs: BOB_INPUTS)) == PAIRING_MISMATCH,
    )
}

#[test]
fn tampered_points_are_rejected() {
    // A replaced by another valid point.
    var swapped = MUL_1
    swapped.a = MUL_1.c
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: swapped, inputs: MUL_1_INPUTS),
            )
            == PAIRING_MISMATCH,
    )

    // A negated: still on the curve.
    var negated = MUL_1
    negated.a = G1 { x: MUL_1.a.x, y: Q - MUL_1.a.y }
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: negated, inputs: MUL_1_INPUTS),
            )
            == PAIRING_MISMATCH,
    )

    // B and C taken from a different valid proof of the same statement.
    var mixed = MUL_1
    mixed.b = MUL_2.b
    mixed.c = MUL_2.c
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: mixed, inputs: MUL_1_INPUTS),
            ) == PAIRING_MISMATCH,
    )
}

#[test]
fn non_canonical_coordinate_is_rejected() {
    var high_y = MUL_1
    high_y.a = G1 { x: MUL_1.a.x, y: MUL_1.a.y + Q }
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: high_y, inputs: MUL_1_INPUTS),
            )
            == COORDINATE_NOT_IN_FIELD,
    )

    var high_b = MUL_1
    high_b.b = G2 {
        x_im: MUL_1.b.x_im + Q,
        x_re: MUL_1.b.x_re,
        y_im: MUL_1.b.y_im,
        y_re: MUL_1.b.y_re,
    }
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: high_b, inputs: MUL_1_INPUTS),
            )
            == COORDINATE_NOT_IN_FIELD,
    )
}

#[test]
fn point_off_the_curve_is_rejected() {
    var off_a = MUL_1
    off_a.a = G1 { x: 1, y: 1 }
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: off_a, inputs: MUL_1_INPUTS),
            ) == NOT_ON_CURVE,
    )

    var off_c = MUL_1
    off_c.c = G1 { x: MUL_1.c.x, y: MUL_1.c.y + 1 }
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: off_c, inputs: MUL_1_INPUTS),
            ) == NOT_ON_CURVE,
    )
}

#[test]
fn invalid_g2_point_is_rejected() {
    var bad_b = MUL_1
    bad_b.b = G2 {
        x_im: MUL_1.b.x_im,
        x_re: MUL_1.b.x_re,
        y_im: MUL_1.b.y_im,
        y_re: MUL_1.b.y_re + 1,
    }
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: bad_b, inputs: MUL_1_INPUTS),
            )
            == PAIRING_CALL_FAILED,
    )
}

// A key whose input point is not on the curve makes ecMul fail.
#[test]
fn malformed_key_is_reported() {
    var bad = MULTIPLIER_VK
    bad.ic = [G1 { x: 1, y: 1 }]
    assert!(
        outcome(verify(vk: bad, proof: MUL_1, inputs: MUL_1_INPUTS)) == COMMITMENT_CALL_FAILED,
    )
}

// The point at infinity is a valid encoding for the precompiles, but a proof
// made of it does not satisfy the equation.
#[test]
fn proof_at_infinity_is_rejected() {
    let zero = Proof {
        a: G1 { x: 0, y: 0 },
        b: G2 { x_im: 0, x_re: 0, y_im: 0, y_re: 0 },
        c: G1 { x: 0, y: 0 },
    }
    assert!(
        outcome(
                verify(vk: MULTIPLIER_VK, proof: zero, inputs: MUL_1_INPUTS),
            ) == PAIRING_MISMATCH,
    )
}

fn call_multiplier(_ addr: Address, proof: Proof, inputs: [u256; 1]) -> bool
uses (evm: mut Evm)
{
    evm.call(
        addr,
        gas: 1000000,
        value: Wei::zero(),
        message: MultiplierVerifierMsg::VerifyProof {
            a: [proof.a.x, proof.a.y],
            b: [[proof.b.x_im, proof.b.x_re], [proof.b.y_im, proof.b.y_re]],
            c: [proof.c.x, proof.c.y],
            inputs,
        },
    )
}

fn call_preimage(_ addr: Address, proof: Proof, inputs: [u256; 2]) -> bool
uses (evm: mut Evm)
{
    evm.call(
        addr,
        gas: 1000000,
        value: Wei::zero(),
        message: PreimageVerifierMsg::VerifyProof {
            a: [proof.a.x, proof.a.y],
            b: [[proof.b.x_im, proof.b.x_re], [proof.b.y_im, proof.b.y_re]],
            c: [proof.c.x, proof.c.y],
            inputs,
        },
    )
}

// The generated contracts answer the same calls as snarkjs's Solidity verifier.
#[test]
fn generated_verifier_contracts() uses (evm: mut Evm) {
    let mul = evm.create2<MultiplierVerifier>(value: Wei::zero(), args: (), salt: 0)
    assert!(call_multiplier(mul, proof: MUL_1, inputs: MUL_1_INPUTS))
    assert!(!call_multiplier(mul, proof: MUL_1, inputs: [34]))
    assert!(!call_multiplier(mul, proof: MUL_1, inputs: [33 + R]))

    let pre = evm.create2<PreimageVerifier>(value: Wei::zero(), args: (), salt: 0)
    assert!(call_preimage(pre, proof: BOB, inputs: BOB_INPUTS))
    assert!(call_preimage(pre, proof: ALICE, inputs: ALICE_INPUTS))
    assert!(!call_preimage(pre, proof: BOB, inputs: ALICE_INPUTS))
}
